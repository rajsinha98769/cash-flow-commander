# Copy to .env and adjust. All are optional — sane local defaults are used.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=collectflow

# File storage backend: "local" (default) or "cloudinary".
STORAGE_DRIVER=local

# --- local driver ---
# Where uploaded invoice/proforma/proof files are stored (default: ./files)
FILES_DIR=./files

# --- cloudinary driver (required only when STORAGE_DRIVER=cloudinary) ---
# From the Cloudinary dashboard → "View API Keys".
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
